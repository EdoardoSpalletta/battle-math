<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomButtonStyle">
        <item name="android:backgroundTint">@color/colorButtonEnabled</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="textAutosizingTitle">
        <item name="android:autoSizeMaxTextSize">100sp</item>
        <item name="android:autoSizeMinTextSize">20sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:fontFamily">@font/steiner</item>
        <item name="android:gravity">center</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>


    <style name="textAutosizingSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeMinTextSize">6sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="textAutosizingMain">
        <item name="android:autoSizeMaxTextSize">20sp</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="textCardDonation">
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:fontFamily">@font/montserrat_black</item>
    </style>

    <style name="textRadiobuttonSelection">
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeMinTextSize">7sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">@font/steiner</item>
        <item name="android:gravity">start</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="ButtonWeaponSelection" parent="Widget.AppCompat.Button">
        <!--Dallo stile generale dell'app -->
        <item name="android:backgroundTint">@color/colorButtonEnabled</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:padding">10dp</item>
        <!-- Dimensioni  -->

        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <!-- Testo -->
        <item name="android:textSize">14sp</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeMaxTextSize">20sp</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">none</item>
        <!-- Font -->
        <item name="android:fontFamily">@font/montserrat_black</item>
    </style>

    <style name="TextDisplayDamage">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="TexInvisible">
        <item name="android:textSize">0sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="TextDisplayCrit">
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/design_default_color_error</item>
    </style>

    <style name="TextAuthor">
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeMinTextSize">6sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="android:gravity">start|bottom</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>